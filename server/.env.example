# Copy this file to .env and fill in real values before running the server.

PORT=8080

# Comma-separated list of origins allowed to call the API from a browser.
# Use * only for local testing — set it to your real site URL(s) in production.
CORS_ORIGIN=http://localhost:8811

# Secret key required (as header "x-api-key") to create/update/delete menu items,
# price zones, or to read the list of booking requests.
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-value

# Where the SQLite database file is stored.
DB_FILE=./data/xbase.db

# Optional: get notified in Telegram when someone submits the booking form, and/or manage
# the club from a Telegram chat (bookings, menu, prices). Leave TELEGRAM_BOT_TOKEN blank to
# skip both — bookings are still saved to the database either way.
# See server/README.md for how to get a bot token and chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional, comma-separated chat/user ids allowed to run bot management commands
# (/bookings, /menu, /addmenu, /price, /prices, /zoneprice, ...). Defaults to TELEGRAM_CHAT_ID
# if left blank. Bot commands are disabled entirely if this and TELEGRAM_CHAT_ID are both empty.
TELEGRAM_ADMIN_IDS=
